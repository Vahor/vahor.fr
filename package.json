{
	"name": "vahor.fr",
	"version": "2.0.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "astro dev --host",
		"start": "ASTRO_LOCAL_PREVIEW=1 astro preview --host --ignore-lock",
		"build": "astro build",
		"build:local": "ASTRO_LOCAL_PREVIEW=1 astro build",
		"test": "playwright test",
		"format": "bunx @biomejs/biome check ./ --write",
		"format:check": "bunx @biomejs/biome format ./",
		"lint": "bunx @biomejs/biome lint ./ --write",
		"typecheck": "astro check",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"biome check --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/node": "^11.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/vercel": "^11.0.17",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@shikijs/transformers": "^4.5.0",
		"@shikijs/twoslash": "^4.5.0",
		"@upstash/redis": "^1.40.0",
		"@vercel/speed-insights": "^2.0.0",
		"astro": "^7.4.4",
		"fast-xml-builder": "^1.3.1",
		"fuse.js": "^7.5.0",
		"hastscript": "^9.0.2",
		"jsdom": "^30.1.3",
		"rehype-pretty-code": "^0.14.5",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"tailwindcss-animate": "^1.0.7",
		"unist-util-visit": "^5.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@terrastruct/d2": "0.1.23",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@vahor/llms-txt": "^0.2.0",
		"@vahor/rehype-d2": "0.0.9",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"remark": "^15.0.1",
		"schema-dts": "^2.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.0"
	}
}
