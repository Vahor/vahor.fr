---
import { getCollection } from "astro:content";
import CopyMailBadge from "../components/CopyMailBadge.astro";
import UrlBadge from "../components/UrlBadge.astro";
import Layout from "../layouts/Layout.astro";
import { profilePage } from "../lib/jsonld";
import { getSpotifyTopTrack } from "../lib/spotify";

export const prerender = false;

const postCount = (await getCollection("posts")).length;
const track = await getSpotifyTopTrack();
---

<Layout jsonLd={profilePage}>
	<main class="post-content container mx-auto py-16 **:leading-7">
		<h1 class="mb-8 font-semibold text-2xl text-black dark:text-white">
			Nathan David
		</h1>
		<section>
			<p>
				Hello <span class="inline-block hover:animate-wiggle">👋🏻</span> Je suis
				un développeur fullstack passionné par les automatisations, la
				performance et l'open-source.
			</p>
		</section>
		<section class="mt-8">
			<p>
				Après un master informatique à{" "}
				<UrlBadge
					url="https://www.mewo.fr"
					title="Mewo"
					favicon="/icons/mewo.png"
				/>{" "}
				effectué en alternance chez{" "}
				<UrlBadge
					url="https://www.sesamm.com/"
					title="SESAMm"
					favicon="/icons/sesamm.svg"
				/>
				, j'occupe désormais le poste de développeur fullstack depuis plus de 4
				ans.
			</p>
		</section>
		<section class="mt-8">
			<p>
				En parallèle, je réalise des projets personnels que je documente sur ce
				site. Vous pouvez retrouver mes{" "}
				<span class="font-semibold">{postCount} articles</span> sur la page{" "}
				<a class="text-primary underline decoration-dashed" href="/tag/all">
					blog
				</a>
				.
			</p>
			<p class="mt-2">
				Par exemple, j'essaie d'apprendre{" "}
				<UrlBadge
					url="https://www.rust-lang.org/"
					title="Rust"
					favicon="/icons/rust.png"
				/>{" "}
				et <UrlBadge url="https://go.dev/" title="Go" favicon="/icons/go.png" />
				.
			</p>
		</section>
		<section class="mt-8">
			<p>
				En dehors de la programmation, j'aime regarder des séries,{" "}
				<a
					class="text-primary underline decoration-dashed"
					href="https://www.kenmei.co/user/vahor?ref=vahor.fr"
					target="_blank"
					rel="noopener noreferrer"
				>
					lire
				</a>{" "}
				et écouter de la musique.
			</p>
			{track && (
				<div
					id="spotify-track"
					class="grid grid-cols-1 gap-2 sm:mt-5 sm:grid-cols-2"
				>
					<div class="hidden justify-end sm:flex">
						<img
							src="/currently-listening.svg"
							alt="En ce moment j'écoute:"
							width="294"
							height="94"
							class="dark:invert"
						/>
					</div>
					<div class="font-semibold sm:hidden">
						<p>En ce moment j'écoute:</p>
					</div>
					<a
						href={track.url}
						title="Ma musique préférée du moment"
						target="_blank"
						rel="noopener noreferrer"
						class="flex flex-row self-start gap-4 rounded-md border bg-card p-2 text-card-foreground"
					>
						<img
							src={track.image}
							alt={track.album}
							width="64"
							height="64"
							class="inline-block h-16 w-16 rounded-lg"
						/>
						<div>
							<div class="font-semibold">{track.name}</div>
							<div class="text-neutral-700 text-sm dark:text-neutral-300">
								{track.artists}
							</div>
						</div>
					</a>
				</div>
			)}
		</section>
		<section class="mt-8">
			<p>
				Vous pouvez me retrouver sur{" "}
				<UrlBadge
					url="https://github.com/vahor"
					title="GitHub"
					favicon="/icons/github-mark.svg"
					darkFavicon="/icons/github-mark-white.svg"
				/>{" "}
				<UrlBadge
					url="https://discordapp.com/users/132552926689230848"
					title="Discord"
					alt="Discord icon"
					favicon="/icons/discord.svg"
				/>
				,{" "}
				<UrlBadge
					url="https://twitter.com/vahor_"
					title="Twitter"
					alt="Twitter icon"
					favicon="/icons/twitter.svg"
				/>
				.
			</p>
			<p class="mt-2">
				Ou me contacter par mail: <CopyMailBadge />
			</p>
		</section>
	</main>
</Layout>
