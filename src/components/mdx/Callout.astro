---
const { type = "note", title, class: className, ...props } = Astro.props;
const variants: Record<
	string,
	{ box: string; text: string; icon: string; path: string; viewBox?: string }
> = {
	info: {
		box: "border-zinc-500/20 bg-zinc-50/50 dark:border-zinc-500/30 dark:bg-zinc-900",
		text: "text-zinc-900 dark:text-zinc-200",
		icon: "text-zinc-400 dark:text-zinc-300",
		viewBox: "0 0 20 20",
		path: "M8 0C3.58125 0 0 3.58125 0 8C0 12.4187 3.58125 16 8 16C12.4187 16 16 12.4187 16 8C16 3.58125 12.4187 0 8 0ZM8 14.5C4.41563 14.5 1.5 11.5841 1.5 8C1.5 4.41594 4.41563 1.5 8 1.5C11.5844 1.5 14.5 4.41594 14.5 8C14.5 11.5841 11.5844 14.5 8 14.5ZM9.25 10.5H8.75V7.75C8.75 7.3375 8.41563 7 8 7H7C6.5875 7 6.25 7.3375 6.25 7.75C6.25 8.1625 6.5875 8.5 7 8.5H7.25V10.5H6.75C6.3375 10.5 6 10.8375 6 11.25C6 11.6625 6.3375 12 6.75 12H9.25C9.66406 12 10 11.6641 10 11.25C10 10.8359 9.66563 10.5 9.25 10.5ZM8 6C8.55219 6 9 5.55219 9 5C9 4.44781 8.55219 4 8 4C7.44781 4 7 4.44687 7 5C7 5.55313 7.44687 6 8 6Z",
	},
	warning: {
		box: "border-amber-500/80 bg-amber-50/80 dark:border-amber-500/30 dark:bg-amber-500/10",
		text: "text-amber-900 dark:text-amber-200 [--list-counter-background:theme(colors.amber.500)] [--list-counter-foreground:theme(colors.amber.900)]",
		icon: "text-amber-400 dark:text-amber-300/80",
		path: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
	},
	note: {
		box: "border-sky-500/20 bg-sky-50/50 dark:border-sky-500/30 dark:bg-sky-500/10",
		text: "text-sky-900 dark:text-sky-200",
		icon: "text-sky-500",
		viewBox: "0 0 14 14",
		path: "M7 1.3C10.14 1.3 12.7 3.86 12.7 7C12.7 10.14 10.14 12.7 7 12.7C5.48908 12.6974 4.0408 12.096 2.97241 11.0276C1.90403 9.9592 1.30264 8.51092 1.3 7C1.3 3.86 3.86 1.3 7 1.3ZM7 0C3.14 0 0 3.14 0 7C0 10.86 3.14 14 7 14C10.86 14 14 10.86 14 7C14 3.14 10.86 0 7 0ZM8 3H6V8H8V3ZM8 9H6V11H8V9Z",
	},
	tip: {
		box: "border-emerald-500/20 bg-emerald-50/50 dark:border-emerald-500/30 dark:bg-emerald-500/10",
		text: "text-emerald-900 dark:text-emerald-200",
		icon: "text-emerald-600 dark:text-emerald-400/80",
		path: "M9 18h6m-6 3h6M9 15c0-2-4-3-4-7a7 7 0 0 1 14 0c0 4-4 5-4 7z",
	},
	check: {
		box: "border-emerald-500/20 bg-emerald-50/50 dark:border-emerald-500/30 dark:bg-emerald-500/10",
		text: "text-emerald-900 dark:text-emerald-200",
		icon: "text-green-600 dark:text-green-400/80",
		path: "m4 12 5 5L20 6",
	},
};
if (!Object.hasOwn(variants, type)) {
	throw new Error(`Unknown callout type: ${type}`);
}
const variant = variants[type];
const filled = type === "info" || type === "note";
---

<div
	class:list={[
		"relative my-4 overflow-hidden rounded-xl border px-5 py-4",
		variant.box,
		className,
	]}
	{...props}
>
	<svg
		role="img"
		aria-label={type}
		viewBox={variant.viewBox ?? "0 0 24 24"}
		fill={filled ? "currentColor" : "none"}
		stroke={filled ? undefined : "currentColor"}
		stroke-width={filled ? undefined : "2"}
		stroke-linecap="round"
		stroke-linejoin="round"
		class:list={["absolute top-4 left-4 size-6", variant.icon]}
	>
		<path
			d={variant.path}
			fill-rule={type === "note" ? "evenodd" : undefined}
			clip-rule={type === "note" ? "evenodd" : undefined}
		/>
	</svg>
	{title && (
		<h3
			class:list={["-translate-y-1 pl-7 font-semibold text-lg", variant.text]}
		>
			{title}
		</h3>
	)}
	<div class:list={["prose flex-1 pl-7 text-sm", variant.text]}>
		<slot />
	</div>
</div>
