---
const { class: className, ...props } = Astro.props;
const html = await Astro.slots.render("default");
const Tag =
	/<(?:address|article|aside|blockquote|details|dialog|div|dl|dt|dd|fieldset|figcaption|figure|footer|form|h[1-6]|header|hgroup|hr|li|main|menu|nav|ol|p|pre|section|summary|table|thead|tbody|tfoot|tr|th|td|ul|video)\b/i.test(
		html,
	)
		? "div"
		: "p";
---

<Tag class:list={["not-first:mt-4", className]} {...props} set:html={html} />
