---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props
	extends Omit<HTMLAttributes<"img">, "src" | "width" | "height"> {
	src: ImageMetadata | string;
	alt: string;
	width?: number;
	height?: number;
}
const { src, alt, class: className, ...props } = Astro.props;
---

<figure class="my-6 text-center">
	{typeof src === "string" ? (
		<img
			src={src.replace(/^(?:\.\.\/)*(?:public|src\/assets)\//, "/")}
			alt={alt}
			class:list={["mx-auto rounded-2xl border object-cover", className]}
			loading="lazy"
			{...props}
		/>
	) : (
		<Image
			src={src}
			alt={alt}
			class:list={["mx-auto rounded-2xl border object-cover", className]}
			loading="lazy"
			{...props}
			width={props.width ?? src.width}
			height={props.height ?? src.height}
		/>
	)}
	<figcaption class="mt-2 text-balance leading-5">{alt}</figcaption>
</figure>
