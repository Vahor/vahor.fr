---
import { Image, type LocalImageProps } from "astro:assets";

type Props = LocalImageProps;
const { src, alt, class: className, ...props } = Astro.props;
---
<figure class="my-6 text-center">
	<Image src={src} alt={alt} class:list={["mx-auto rounded-2xl border object-cover", className]} loading="lazy" {...props} />
	<figcaption class="mt-2 text-balance leading-5">{alt}</figcaption>
</figure>
