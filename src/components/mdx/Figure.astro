---
import CodeActions from "./CodeActions.astro";

const { class: className, ...props } = Astro.props;
const isCode = props["data-rehype-pretty-code-figure"] !== undefined;
const html = await Astro.slots.render("default");
const title = html.match(
	/<figcaption\b[^>]*data-rehype-pretty-code-title[^>]*>([\s\S]*?)<\/figcaption>/,
);
const body = title ? html.replace(title[0], "") : html;
---

{isCode ? (
	<div
		class:list={[
			"relative my-3 h-full overflow-hidden rounded-2xl bg-zinc-50 dark:bg-zinc-900 group",
			className,
		]}
		data-code-block
		{...props}
	>
		{title && (
			<div class="flex h-11 items-center justify-between rounded-t-2xl border-border border-b bg-zinc-100 px-3 pr-5 dark:bg-zinc-800">
				<div
					class="mr-auto font-semibold text-xs dark:text-white"
					set:html={title[1]}
				/>
				<div class="flex items-center gap-2 text-zinc-500" data-actions>
					<CodeActions />
				</div>
			</div>
		)}
		<div
			class="relative h-full overflow-hidden"
			style="font-variant-ligatures: none"
		>
			{!title && (
				<div
					class="absolute top-[16px] right-4 z-[1] flex items-center gap-2 text-zinc-500"
					data-actions
				>
					<CodeActions />
				</div>
			)}
			<Fragment set:html={body} />
		</div>
	</div>
) : (
	<figure class={className} {...props} set:html={html} />
)}
