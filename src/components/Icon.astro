---
interface Props {
	name: keyof typeof paths;
	class?: string;
}
const { name, class: className = "size-4" } = Astro.props;
const paths = {
	x: ["M18 6 6 18", "m6 6 12 12"],
	search: ["m21 21-4.34-4.34", "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16"],
	sun: [
		"M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4",
		"M16 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0",
	],
	moon: ["M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13"],
	clock: ["M12 8v4l2 2", "M22 12a10 10 0 1 0-20 0 10 10 0 0 0 20 0"],
	calendar: [
		"M8 2v4m8-4v4M3 10h18",
		"M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2",
	],
	pencil: ["m16 3 5 5M4 16 16 4a3.5 3.5 0 0 1 5 5L9 21H3l1-5"],
	send: ["m22 2-7 20-4-9-9-4 20-7Z", "M22 2 11 13"],
	check: ["m20 6-11 11-5-5"],
};
---

<svg
	aria-hidden="true"
	xmlns="http://www.w3.org/2000/svg"
	width="24"
	height="24"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
>
	{paths[name].map((d) => (
		<path d={d} />
	))}
</svg>
